# ============================================================================
# Codinative Dashboard — environment template
# Copy to .env.local and fill in. NEVER commit .env.local.
#
# Only the BOOTSTRAP block below is required. The admin login can also be
# configured from the in-app Settings page, which stores it encrypted in the
# dashboard's own Firestore. Values set in the UI take precedence over the
# matching env vars here.
# ============================================================================

# ============================================================================
# REQUIRED (bootstrap) — these can't move into the UI, they unlock it.
# ============================================================================

# --- Dashboard's own Firebase project (stores all dashboard data: secrets,
#     projects, QA, team logins and the admin login) -------------------------
DASHBOARD_FIREBASE_PROJECT_ID=
DASHBOARD_FIREBASE_CLIENT_EMAIL=
DASHBOARD_FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Encryption (encrypts the secrets vault) ---------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- NextAuth v5 (Auth.js) ---------------------------------------------------
# Generate AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ============================================================================
# OPTIONAL — first-run defaults. You can instead set these from Settings once
# the app is running (stored in Firestore, overriding anything below).
# ============================================================================

# --- Single admin login (bootstrap default) ---------------------------------
# Hash a password: node -e "require('bcryptjs').hash('yourpassword', 12).then(console.log)"
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD_HASH=

# --- Login-alert email (optional, security) ----------------------------------
# Emails you on every successful login. Master switch: set to false to disable
# entirely (default is on when SMTP is configured). For Gmail: enable 2-Step
# Verification, then create an App Password (Google Account → Security → App
# passwords) and use it as SMTP_PASS.
LOGIN_ALERT_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=
LOGIN_ALERT_EMAIL=you@gmail.com

# Two-step login: email an 8-digit code as a second factor (needs SMTP above).
# Default on when SMTP is configured; set false to disable. If SMTP is not
# configured this is automatically off (so you can't get locked out).
LOGIN_OTP_ENABLED=true
