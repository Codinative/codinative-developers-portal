# ============================================================================
# Codinative Dashboard — environment template
# Copy to .env.local and fill in. NEVER commit .env.local.
#
# Only the BOOTSTRAP block below is required. Monitored Firebase projects and
# the admin login can now also be configured from the in-app Settings page
# (Settings → Connect Firebase project / Login credentials), which stores them
# encrypted in the dashboard's own Firestore. Values set in the UI take
# precedence over the matching env vars here.
# ============================================================================

# ============================================================================
# REQUIRED (bootstrap) — these can't move into the UI, they unlock it.
# ============================================================================

# --- Dashboard's own Firebase project (stores `secrets`, connected projects,
#     and the admin login) ---------------------------------------------------
DASHBOARD_FIREBASE_PROJECT_ID=
DASHBOARD_FIREBASE_CLIENT_EMAIL=
DASHBOARD_FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Encryption (encrypts the secrets vault AND stored service-account keys) --
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- NextAuth v5 (Auth.js) ---------------------------------------------------
# Generate AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ============================================================================
# OPTIONAL — first-run defaults. You can instead set these from Settings once
# the app is running (stored in Firestore, overriding anything below).
# ============================================================================

# --- Single admin login (bootstrap default) ---------------------------------
# Hash a password: node -e "require('bcryptjs').hash('yourpassword', 12).then(console.log)"
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD_HASH=

# --- Per-app read-only service accounts (alternative to connecting in the UI)-
# Prefixes must match `envPrefix` in lib/apps-config.ts. Leave blank if you
# connect these projects from Settings instead.
FB_SIGNUP_PROJECT_ID=bc-signup-customisation-app
FB_SIGNUP_CLIENT_EMAIL=
FB_SIGNUP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

FB_WEIGHT_PROJECT_ID=bc-weight-based-shipping
FB_WEIGHT_CLIENT_EMAIL=
FB_WEIGHT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Google OAuth (Settings → "Auto-discover with Google") -------------------
# Enables connecting a Google account to auto-list & add its Firebase projects.
# Create an OAuth 2.0 Client (type: Web application) in Google Cloud Console and
# add the redirect URI: <your-url>/api/google/callback
# (e.g. http://localhost:3000/api/google/callback and the prod equivalent).
# See docs/SETTINGS.md for the full walkthrough. Leave blank to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
