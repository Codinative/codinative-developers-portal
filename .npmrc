# next-auth@5 (beta) declares an *optional* peer dependency on nodemailer@^7.
# We run nodemailer@9 (7.x has unpatched CVEs and no further releases) and only
# use next-auth's Credentials provider — its Email/Nodemailer provider is never
# loaded, so the mismatch is cosmetic. This keeps `npm install` / `npm ci` and
# CI/Vercel deploys from failing on that optional-peer ERESOLVE.
legacy-peer-deps=true
