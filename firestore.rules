rules_version = '2';

// Rules for the DASHBOARD's own Firebase project (the one holding `secrets`).
// The Admin SDK used by Server Actions bypasses these rules; clients/browsers
// are blocked entirely.
service cloud.firestore {
  match /databases/{database}/documents {

    // Encrypted secrets — server-side (Admin SDK) only.
    match /secrets/{secretId} {
      allow read, write: if false;
    }

    // App config (admin login credentials) — server-side only.
    match /appConfig/{docId} {
      allow read, write: if false;
    }

    // Team member logins (bcrypt-hashed passwords) — server-side only.
    match /dashboardUsers/{userId} {
      allow read, write: if false;
    }

    // QA checklists (app-review / QA runs) — server-side (Admin SDK) only.
    match /qaChecklists/{checklistId} {
      allow read, write: if false;
    }

    // Project hub (manual projects + their links) — server-side only.
    match /projects/{projectId} {
      allow read, write: if false;
    }

    // Login OTP codes (hashed, short-lived) — server-side only.
    match /loginOtps/{docId} {
      allow read, write: if false;
    }

    // Lock down everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
